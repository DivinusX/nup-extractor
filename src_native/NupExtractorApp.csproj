<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Allow the WPF shell to be compiled on Linux (solution builds); it still only runs on Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>..\app_icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <Authors>SPIN0ZAi</Authors>
    <Company>SPIN0ZAi</Company>
    <Product>NUP Extractor</Product>
    <Description>High-performance Nintendo Switch clean-room container extraction utility for Windows</Description>
    <Copyright>Copyright © 2026 SPIN0ZAi</Copyright>
    <PackageProjectUrl>https://github.com/SPIN0ZAi/nup-extractor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SPIN0ZAi/nup-extractor</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- Engine, IPC router and embedded static UI come from the shared core -->
  <ItemGroup>
    <ProjectReference Include="..\src_core\NupExtractorCore.csproj" />
  </ItemGroup>

</Project>
