<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Keep the historic namespace so moved types and embedded resource names stay stable -->
    <RootNamespace>NupExtractorApp</RootNamespace>
    <AssemblyName>NupExtractorCore</AssemblyName>
    <Authors>SPIN0ZAi</Authors>
    <Company>SPIN0ZAi</Company>
    <Product>NUP Extractor</Product>
    <Description>Cross-platform container engine, IPC router and update manager for NUP Extractor</Description>
    <Copyright>Copyright © 2026 SPIN0ZAi</Copyright>
    <PackageProjectUrl>https://github.com/SPIN0ZAi/nup-extractor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SPIN0ZAi/nup-extractor</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <!-- Embed static UI assets into the core assembly (served by both shells) -->
  <ItemGroup>
    <EmbeddedResource Include="..\static\**\*">
      <Link>static\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
