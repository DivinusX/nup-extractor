<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>NUP_Extractor</AssemblyName>
    <RootNamespace>NupExtractorApp</RootNamespace>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Authors>SPIN0ZAi</Authors>
    <Company>SPIN0ZAi</Company>
    <Product>NUP Extractor</Product>
    <Description>High-performance Nintendo Switch clean-room container extraction utility for Linux (native, no Wine)</Description>
    <Copyright>Copyright © 2026 SPIN0ZAi</Copyright>
    <PackageProjectUrl>https://github.com/SPIN0ZAi/nup-extractor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SPIN0ZAi/nup-extractor</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src_core\NupExtractorCore.csproj" />
  </ItemGroup>

  <!-- Package the Windows .ico so the Linux window icon can be extracted at runtime -->
  <ItemGroup>
    <EmbeddedResource Include="..\app_icon.ico">
      <Link>assets\app_icon.ico</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
